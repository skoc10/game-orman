[gd_scene format=3]

[ext_resource type="Script" path="res://world/world.gd" id="1_world"]
[ext_resource type="PackedScene" path="res://player/player.tscn" id="2_player"]
[ext_resource type="PackedScene" path="res://ui/hud.tscn" id="3_hud"]
[ext_resource type="PackedScene" path="res://ui/inventory_screen.tscn" id="4_inv"]
[ext_resource type="PackedScene" path="res://ui/build_menu.tscn" id="5_build"]
[ext_resource type="PackedScene" path="res://ui/storage_screen.tscn" id="6_storage"]
[ext_resource type="PackedScene" path="res://ui/pause_menu.tscn" id="7_pause"]
[ext_resource type="PackedScene" path="res://ui/touch_controls.tscn" id="8_touch"]
[ext_resource type="PackedScene" path="res://ui/trade_screen.tscn" id="9_trade"]

[node name="World" type="Node3D"]
script = ExtResource("1_world")

[node name="Player" parent="." instance=ExtResource("2_player")]

[node name="HUD" parent="." instance=ExtResource("3_hud")]

[node name="InventoryScreen" parent="." instance=ExtResource("4_inv")]

[node name="BuildMenu" parent="." instance=ExtResource("5_build")]

[node name="StorageScreen" parent="." instance=ExtResource("6_storage")]

[node name="TradeScreen" parent="." instance=ExtResource("9_trade")]

[node name="TouchControls" parent="." instance=ExtResource("8_touch")]

[node name="PauseMenu" parent="." instance=ExtResource("7_pause")]
